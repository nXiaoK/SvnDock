<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared registry, command queue and badge cache for Finder Sync. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(SVNDOCK_APP_GROUP_IDENTIFIER)</string>
    </array>

    <!--
      MVP builds intentionally run outside App Sandbox because they execute the
      user's Homebrew/system svn binary. Hardened Runtime, Developer ID signing
      and notarization should still be enabled in the Xcode target.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
